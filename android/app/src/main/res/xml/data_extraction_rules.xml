<?xml version="1.0" encoding="utf-8"?>
<!-- O banco é cifrado com uma chave do Keystore, que não vai para o backup.
     Copiar o banco para a nuvem só geraria um arquivo ilegível; por isso
     nada é copiado. A sincronização (M8) é opcional e não leva oração,
     diário nem pedidos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
